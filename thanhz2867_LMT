local isFarming = false
local visualPart = nil
local farmThread = nil

local function setCharacterFreeze(freeze)
    local char = LocalPlayer.Character
    if not char then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = freeze
        end
    end
end

local function updateVisualPart()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not visualPart or not visualPart.Parent then
        visualPart = Instance.new("Part")
        visualPart.Name = "VisualBlock_bakhivc"
        visualPart.Size = Vector3.new(15, 3, 15)
        visualPart.Anchored = true
        visualPart.CanCollide = true
        visualPart.Material = Enum.Material.ForceField
        visualPart.Color = Color3.fromRGB(0, 255, 255)
        visualPart.Transparency = 0.4
        visualPart.Parent = workspace
    end

    visualPart.CFrame = hrp.CFrame * CFrame.new(0, 4, 0)
end

local function removeVisualPart()
    if visualPart then
        visualPart:Destroy()
        visualPart = nil
    end
end

local function stopFarm()
    isFarming = false
    farmBtn.Text = "Auto Farm"
    farmBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
    timerLabel.Text = "Trạng thái: Đã dừng"
    timerLabel.TextColor3 = Color3.fromRGB(200, 200, 200)

    if farmThread then
        task.cancel(farmThread)
        farmThread = nil
    end

    setCharacterFreeze(false)
    removeVisualPart()
end

farmBtn.MouseButton1Click:Connect(function()
    if isFarming then
        stopFarm()
    else
        isFarming = true
        farmBtn.Text = "Stop Farm"
        farmBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)

        farmThread = task.spawn(function()
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hrp = char:WaitForChild("HumanoidRootPart", 5)

            if hrp then
                -- Dịch chuyển nhân vật đến vị trí
                hrp.CFrame = CFrame.new(TARGET_POS)
                setCharacterFreeze(true)
                updateVisualPart()

                -- Giữ trạng thái Teleport Hold liên tục
                while isFarming do
                    timerLabel.Text = "Đang Hold TP..."
                    timerLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
                    task.wait(0.5)
                end
            end
        end)
    end
end)

LocalPlayer.CharacterRemoving:Connect(function()
    stopFarm()
end)

task.delay(2.5, function()
    local tweenInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local fadeIntro = TweenService:Create(introFrame, tweenInfo, {BackgroundTransparency = 1})
    
    TweenService:Create(eyeImage, tweenInfo, {ImageTransparency = 1}):Play()
    TweenService:Create(titleText, tweenInfo, {TextTransparency = 1}):Play()
    TweenService:Create(authorText, tweenInfo, {TextTransparency = 1}):Play()
    
    fadeIntro:Play()
    fadeIntro.Completed:Connect(function()
        introFrame:Destroy()
        mainFrame.Visible = true
    end)
end)
