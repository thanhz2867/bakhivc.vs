local isFarming = false
local visualPart = nil
local farmThread = nil

local function getNearestFarmSpot()
    local char = LocalPlayer.Character
    if not char then return FARM_SPOTS[1] end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return FARM_SPOTS[1] end

    local currentPos = hrp.Position
    local nearestSpot = FARM_SPOTS[1]
    local minDistance = math.huge

    for _, spot in ipairs(FARM_SPOTS) do
        local dist = (currentPos - spot).Magnitude
        if dist < minDistance then
            minDistance = dist
            nearestSpot = spot
        end
    end

    return nearestSpot
end

local function updateVisualPart()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not visualPart or not visualPart.Parent then
        visualPart = Instance.new("Part")
        visualPart.Name = "VisualBlock_bakhivc"
        visualPart.Size = Vector3.new(15, 3, 15)
        visualPart.Anchored = true
        visualPart.CanCollide = true
        visualPart.Material = Enum.Material.ForceField
        visualPart.Color = Color3.fromRGB(0, 255, 255)
        visualPart.Transparency = 0.4
        visualPart.Parent = workspace
    end

    visualPart.CFrame = hrp.CFrame * CFrame.new(0, 4, 0)
end

local function removeVisualPart()
    if visualPart then
        visualPart:Destroy()
        visualPart = nil
    end
end

local function stopFarm()
    isFarming = false
    toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 50, 70)
    toggleCircle.Position = UDim2.new(0, 2, 0.5, -8)

    if farmThread then
        task.cancel(farmThread)
        farmThread = nil
    end

    setCharacterFreeze(false)
    removeVisualPart()
end

toggleBtn.MouseButton1Click:Connect(function()
    if isFarming then
        stopFarm()
    else
        isFarming = true
        toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
        toggleCircle.Position = UDim2.new(1, -18, 0.5, -8)

        farmThread = task.spawn(function()
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hrp = char:WaitForChild("HumanoidRootPart", 5)

            if hrp then
                local targetSpot = getNearestFarmSpot()
                hrp.CFrame = CFrame.new(targetSpot)
                
                setCharacterFreeze(true)
                updateVisualPart()

                while isFarming do
                    task.wait(0.5)
                end
            end
        end)
    end
end)

LocalPlayer.CharacterRemoving:Connect(function()
    stopFarm()
end)

